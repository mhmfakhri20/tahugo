# Salin ke .env lalu jalankan `php artisan key:generate`. Jangan commit .env (berisi rahasia).
#
# Untuk PRODUCTION (lihat F7b), ubah minimal:
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://domain-anda        (HTTPS wajib untuk kamera & GPS)
#   LOG_LEVEL=warning
#   SESSION_SECURE_COOKIE=true
#   DB_* sesuai server, dengan user database khusus (bukan root)
# Seeder akun dev (password "password") & DemoSeeder tidak berjalan saat APP_ENV=production.

APP_NAME="Tahu Go"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tahugo
DB_USERNAME=root
DB_PASSWORD=

# Sesi harus >= batas idle terpanjang (penjaga outlet 600 menit).
SESSION_DRIVER=database
SESSION_LIFETIME=600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true

# Logout otomatis saat tidak aktif, dalam menit (AUTH-6, config/tahugo.php).
IDLE_TIMEOUT_OWNER=60
IDLE_TIMEOUT_WAREHOUSE=60
IDLE_TIMEOUT_OUTLET=600

BROADCAST_CONNECTION=log
# Foto absen/nota/tutup shift disimpan di disk privat "local" (storage/app/private).
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
